{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doer",
  "version": "0.1.0",
  "identifier": "com.doer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Doer",
        "width": 520,
        "height": 760,
        "minWidth": 400,
        "minHeight": 520,
        "label": "main"
      },
      {
        "label": "bubble",
        "title": "Doer Bubble",
        "url": "bubble.html",
        "width": 56,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "x": 0,
        "y": 0,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
